# ========================================================
# BABY'S BAZAAR — PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

# 1. Supabase Public Credentials (Safe for Browser & Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Supabase Admin Credentials (SERVER-ONLY — Never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 3. Google Places API (SERVER-ONLY — Never expose to browser)
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# 4. Google Place ID for Baby's Bazaar (Erode, Tamil Nadu)
NEXT_PUBLIC_GOOGLE_PLACE_ID=your-google-place-id

# 5. Production Canonical Site URL (No trailing slash)
NEXT_PUBLIC_SITE_URL=https://babysbazaar.com
